{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build tspp",
			"type": "shell",
			"command": "./build.sh",
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build tspp (release)",
			"type": "shell",
			"command": "./build.sh",
			"args": [
				"--release"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "Run test suite",
			"type": "shell",
			"command": "tests/run.sh",
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "Run function tests",
			"type": "shell",
			"command": "./test.sh",
			"args": [
				"tests/functions/simple_test.tspp"
			]
		},
		{
			"label": "Run for-var-decl test",
			"type": "shell",
			"command": "./test.sh",
			"args": [
				"tests/loops/for_var_decl.tspp"
			]
		}
	]
}
