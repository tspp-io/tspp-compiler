// Passing smoke test: integer arithmetic, loops, functions, bool printing.
// Sections taken from tests/final.tspp, whose float/static parts are xfail.
function isEven(n: int): bool { return (n % 2) == 0; }

function sumTo(n: int): int {
  let s: int = 0;
  let i: int = 1;
  while (i <= n) {
    s = s + i;
    i = i + 1;
  }
  return s;
}

function forVariants(): int {
  let total: int = 0;
  for (let i: int = 0; i < 3; i = i + 1) { total = total + i; }
  let j: int = 0;
  for (j = 0; j < 2; j = j + 1) { total = total + 10; }
  let k: int = 0;
  for (; k < 2; k = k + 1) { total = total + 100; }
  return total;
}

function main(): int {
  console.log("isEven(6): ", isEven(6));
  console.log("isEven(7): ", isEven(7));
  console.log("sumTo(5): ", sumTo(5));
  console.log("forVariants(): ", forVariants());
  console.log("2 + 3 * 4 = ", 2 + 3 * 4);
  console.log("(1 + 1) << 3 = ", (1 + 1) << 3);
  console.log("5 & 3 = ", 5 & 3);
  console.log("5 | 3 = ", 5 | 3);
  console.log("5 ^ 3 = ", 5 ^ 3);
  console.log("~0 = ", ~0);
  console.log("17 % 5 = ", 17 % 5);
  let x: int = 0;
  let y: int = 0;
  x = y = 5;
  console.log("x, y: ", x, ", ", y);
  let L: bool = (false && (1/0 == 0)) || true;
  console.log("logical: ", L);
  let n: int = 10;
  n += 5;
  n -= 3;
  n *= 2;
  n++;
  console.log("n: ", n);
  console.log("ternary: ", n > 20 ? "big" : "small");
  return 0;
}
