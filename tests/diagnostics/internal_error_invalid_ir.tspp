// test: compile-error
// error: tspp: internal compiler error: generated LLVM IR is invalid (this is a compiler bug):
// error: Branch condition is not 'i1' type!
// Invalid IR is caught by llvm::verifyModule inside the compiler (H6) and
// reported as an internal compiler error, instead of being written out and
// rejected later by llvm-as. This pins that path with a known codegen bug
// (an int used as a condition emits 'br i32'); when that bug is fixed, switch
// this test to another known invalid-IR case or delete it.
function main(): int {
  let n: int = 2;
  if (n) {
    console.log("n is non-zero");
  }
  return 0;
}
