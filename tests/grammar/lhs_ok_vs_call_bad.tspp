// test: compile-error
// error: lhs_ok_vs_call_bad.tspp:10:3: error: unsupported assignment target
// EXPECT_COMPILE_ERROR: invalid assignment target

function f(x: int): int { return x; }

function main(): int {
  let y: int = 0;
  // Bad: call on LHS
  f(1) = y;
  // Good: property assignment
  let holder: int*; // avoid null deref; do nothing at runtime
  return 0;
}
