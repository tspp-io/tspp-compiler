// H3: one check per precedence level, from tightest to loosest
// (TypeScript/C order, docs/grammar.md "Operator precedence"):
//   unary > * / % > + - > << >> > < <= > >= > == != > & > ^ > | > && > || > ?: > =
// Each expression is chosen so that the wrong grouping gives a different
// result; the comment shows the correct grouping. Comparisons print
// "cond ? 1 : 0" (1 = correct grouping): a string-typed ?: concatenated
// into a string prints an address (separate bug).
function main(): int {
  // unary binds tighter than everything
  console.log("unary-minus: " + (-2 + 3));          // (-2) + 3 = 1
  console.log("unary-plus: " + (+3 * 2));           // (+3) * 2 = 6
  console.log("unary-tilde: " + (~0 & 5));          // (~0) & 5 = 5
  console.log("double-minus: " + (- -3));           // -(-3) = 3
  let t: bool = true;
  console.log("unary-not: " + (!t == false ? 1 : 0)); // (!t) == false

  // multiplicative > additive, left-associative
  console.log("mul-add: " + (2 + 3 * 4));           // 2 + (3 * 4) = 14
  console.log("div-sub: " + (10 - 6 / 2));          // 10 - (6 / 2) = 7
  console.log("mod-add: " + (7 + 8 % 3));           // 7 + (8 % 3) = 9
  console.log("sub-left: " + (10 - 4 - 3));         // (10 - 4) - 3 = 3
  console.log("div-left: " + (100 / 10 / 5));       // (100 / 10) / 5 = 2
  console.log("mul-mod-left: " + (2 * 3 % 4));      // (2 * 3) % 4 = 2

  // additive > shift
  console.log("add-shl: " + (1 << 2 + 3));          // 1 << (2 + 3) = 32
  console.log("sub-shr: " + (64 >> 3 - 1));         // 64 >> (3 - 1) = 16

  // shift > relational
  console.log("shl-lt: " + (1 << 3 < 9 ? 1 : 0));   // (1 << 3) < 9
  console.log("shr-ge: " + (16 >> 2 >= 4 ? 1 : 0)); // (16 >> 2) >= 4

  // relational > equality
  console.log("lt-eq: " + (1 < 2 == 3 < 4 ? 1 : 0)); // (1 < 2) == (3 < 4)
  console.log("gt-ne: " + (2 > 1 != 1 > 2 ? 1 : 0)); // (2 > 1) != (1 > 2)

  // equality > &
  console.log("eq-bitand: " + (5 & 3 == 3));        // 5 & (3 == 3) = 1

  // & > ^
  console.log("bitand-xor: " + (6 ^ 3 & 1));        // 6 ^ (3 & 1) = 7

  // ^ > |
  console.log("xor-bitor: " + (1 | 6 ^ 3));         // 1 | (6 ^ 3) = 5

  // | > &&
  console.log("bitor-and: " + ((1 | 2) == 3 && 0 | 1 == 1 ? 1 : 0));

  // && > ||
  let f: bool = false;
  console.log("and-or: " + (t || f && f ? 1 : 0));  // t || (f && f)
  console.log("or-and: " + (f && f || t ? 1 : 0));  // (f && f) || t

  // || > ?:
  console.log("or-cond: " + (f || t ? 1 : 2));      // (f || t) ? 1 : 2 = 1

  // ?: is right-associative
  console.log("cond-right: " + (f ? 1 : t ? 2 : 3)); // f ? 1 : (t ? 2 : 3) = 2

  // ?: > assignment, assignment is right-associative
  let x: int = 0;
  let y: int = 0;
  x = f ? 1 : 2;
  console.log("assign-cond: " + x);                 // x = (f ? 1 : 2) = 2
  x = y = 5;
  console.log("assign-right: " + x + " " + y);      // x = (y = 5): 5 5
  x += y -= 1;
  console.log("compound-right: " + x + " " + y);    // x += (y -= 1): 9 4
  return 0;
}
